{
  "name": "sunto",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @sunto/app dev",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build:web": "pnpm --filter @sunto/app build",
    "build:desktop": "pnpm build:web && pnpm --filter @sunto/desktop build",
    "ios:sync": "pnpm build:web && node scripts/sync-ios.mjs",
    "ios:open": "pnpm --filter @sunto/mobile open",
    "typecheck": "tsc --noEmit && pnpm --filter @sunto/app typecheck",
    "lint": "eslint .",
    "check:desktop": "pnpm build:web && pnpm --filter @sunto/desktop smoke",
    "ios:build": "pnpm ios:sync && xcodebuild -project apps/mobile/ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -derivedDataPath apps/mobile/DerivedData CODE_SIGNING_ALLOWED=NO build"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "latest",
    "globals": "latest",
    "@types/node": "^22.0.0"
  }
}
