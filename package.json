{
  "name": "sunto",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @sunto/app dev",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build:web": "pnpm --filter @sunto/app build",
    "build:desktop": "pnpm build:web && pnpm --filter @sunto/desktop build",
    "ios:sync": "pnpm build:web && node scripts/sync-ios.mjs",
    "ios:open": "pnpm --filter @sunto/mobile open",
    "ios:install": "node scripts/install-ios.mjs",
    "ios:auto-install": "node scripts/ios-auto-install.mjs setup",
    "ios:auto-install:remove": "node scripts/ios-auto-install.mjs remove",
    "mac:install": "node scripts/install-mac.mjs",
    "icons": "node scripts/build-icons.mjs",
    "mcp:build": "pnpm --filter @sunto/mcp build",
    "typecheck": "tsc --noEmit && pnpm --filter @sunto/app typecheck && pnpm --filter @sunto/mcp typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write . && pnpm native:format",
    "format:check": "prettier --check . && pnpm native:check",
    "native:format": "node scripts/check-native.mjs --write",
    "native:check": "node scripts/check-native.mjs --check",
    "prepare": "husky",
    "check:desktop": "pnpm build:web && pnpm --filter @sunto/desktop smoke",
    "ios:build": "pnpm ios:sync && xcodebuild -project apps/mobile/ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -derivedDataPath apps/mobile/DerivedData CODE_SIGNING_ALLOWED=NO build",
    "test:storage": "node scripts/test-storage.mjs",
    "test:mcp": "pnpm --filter @sunto/mcp test"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{swift,plist,pbxproj,entitlements,xcprivacy,storyboard,xib,xcworkspacedata,xcscheme,xml}": "node scripts/check-native.mjs --write",
    "!(*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,swift,plist,pbxproj,entitlements,xcprivacy,storyboard,xib,xcworkspacedata,xcscheme,xml})": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "latest",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.10.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "latest"
  }
}
